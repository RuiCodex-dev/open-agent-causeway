# Causeway configuration. Placeholders only - never commit real values.

# --- Model provider -------------------------------------------------------
# meterless = Meterless Runtime / Nightshift (primary provider, OpenAI-compatible)
# nvidia    = build.nvidia.com hosted Nemotron (direct)
# nebius    = Nebius Token Factory Nemotron (failover)
# offline   = deterministic offline reasoner (no model, no key)
MODEL_PROVIDER=meterless

# Meterless Runtime (Nightshift hotspot). Model ids are routing modes, e.g. meterless/deep
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-runtime-token-here
METERLESS_MODEL=meterless/deep
METERLESS_APP_ID=causeway

# Direct NVIDIA (build.nvidia.com)
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=your-nvidia-key-here
MODEL_REASONER=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_EMBED=nvidia/nemotron-3-embed-1b
MODEL_GUARD=nvidia/nemotron-3.5-content-safety
NVIDIA_RPM_BUDGET=32

# Nebius Token Factory (failover)
FALLBACK_BASE_URL=https://api.tokenfactory.nebius.com/v1/
FALLBACK_API_KEY=your-nebius-key-here

# --- Data -----------------------------------------------------------------
# Live Zetaris instance (REST). Leave empty to run on the bundled Zetaris snapshot.
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=your-zetaris-api-key-here
# true = snapshot + DuckDB (no Zetaris needed); false = live; empty = auto
SAMPLE_MODE=

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=info
PORT=8000
UI_PORT=8080

# Owner ledger database (local demo Postgres for Zetaris option A)
CAUSEWAY_LEDGER_PASSWORD=choose-a-local-password
